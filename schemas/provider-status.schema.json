{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gasyoun/RuWritingStyles/schemas/provider-status.schema.json",
  "title": "RuWritingStyles provider status",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "provider",
      "ready",
      "model",
      "api_key_env",
      "configured_env",
      "missing_env"
    ],
    "additionalProperties": false,
    "properties": {
      "provider": {
        "type": "string",
        "enum": ["mock", "openai", "google", "anthropic"]
      },
      "ready": {
        "type": "boolean"
      },
      "model": {
        "type": "string",
        "minLength": 1
      },
      "api_key_env": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      },
      "configured_env": {
        "type": "string"
      },
      "missing_env": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    }
  }
}
