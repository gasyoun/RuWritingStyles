{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gasyoun/RuWritingStyles/schemas/verification-output.schema.json",
  "title": "RuWritingStyles verification provider output",
  "type": "object",
  "required": ["run_id", "status", "passed", "warnings"],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "needs_human_review", "failed"]
    },
    "passed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
