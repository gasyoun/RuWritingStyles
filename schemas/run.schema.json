{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gasyoun/RuWritingStyles/schemas/run.schema.json",
  "title": "RuWritingStyles run metadata",
  "type": "object",
  "required": ["run_id", "status", "text_domain"],
  "properties": {
    "run_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["prepared", "executing", "completed", "failed"]
    },
    "text_domain": { "type": "string", "default": "unknown" },
    "input_path": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": ["string", "null"] },
    "archetype": { "type": ["string", "null"] },
    "profile": { "type": ["string", "null"] },
    "started_at": { "type": ["string", "null"] },
    "finished_at": { "type": ["string", "null"] },
    "duration_seconds": { "type": ["number", "null"] },
    "summary": { "type": ["string", "null"] },
    "config": { "type": ["object", "null"] },
    "metrics": { "type": "object" },
    "steps": { "type": "array", "items": { "type": "object" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
