{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gasyoun/RuWritingStyles/schemas/revision-output.schema.json",
  "title": "RuWritingStyles revision provider output",
  "type": "object",
  "required": ["run_id", "status", "applied_changes", "unresolved"],
  "additionalProperties": true,
  "properties": {
    "run_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["completed"]
    },
    "revised_document": {
      "type": "string",
      "description": "Legacy/advisory only. The engine ignores this field and reconstructs revised.md from applied_changes; it is accepted but never used."
    },
    "applied_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["span_id", "replacement_text"],
        "properties": {
          "span_id": {
            "type": "string",
            "minLength": 1
          },
          "replacement_text": {
            "type": "string"
          },
          "source_findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "change_type": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
