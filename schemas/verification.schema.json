{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gasyoun/RuWritingStyles/schemas/verification.schema.json",
  "title": "RuWritingStyles verification artifact",
  "type": "object",
  "required": [
    "run_id",
    "status",
    "prompt_path",
    "revision_file",
    "passed",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["prompt_ready", "passed", "needs_human_review", "failed"]
    },
    "prompt_path": {
      "type": "string",
      "minLength": 1
    },
    "revision_file": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
