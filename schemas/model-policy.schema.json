{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gasyoun/RuWritingStyles/schemas/model-policy.schema.json",
  "title": "RuWritingStyles model routing policy",
  "type": "object",
  "required": [
    "version",
    "schema",
    "default_provider",
    "default_development_mode",
    "providers",
    "policy_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "schema": { "type": "string" },
    "description": { "type": "string" },
    "default_provider": {
      "type": "string",
      "enum": ["openai", "google", "anthropic"]
    },
    "default_development_mode": {
      "type": "object",
      "required": ["model", "reasoning", "speed", "use_for"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "reasoning": { "type": "string" },
        "speed": { "type": "string" },
        "use_for": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1
    },
    "policy_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "budget_modes": {
      "type": "object",
      "required": ["smoke", "standard", "expensive"],
      "additionalProperties": false,
      "properties": {
        "smoke": {
          "type": "object",
          "required": ["description", "providers", "max_outbound_attempts", "max_tokens", "max_wall_seconds"],
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string" },
            "providers": { "type": "array", "items": { "type": "string" } },
            "max_outbound_attempts": { "type": "integer", "minimum": 1 },
            "max_tokens": { "type": "integer", "minimum": 1 },
            "max_wall_seconds": { "type": "integer", "minimum": 1 },
            "explicit_selection_required": { "type": "boolean" }
          }
        },
        "standard": {
          "type": "object",
          "required": ["description", "providers", "max_outbound_attempts", "max_tokens", "max_wall_seconds"],
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string" },
            "providers": { "type": "array", "items": { "type": "string" } },
            "max_outbound_attempts": { "type": "integer", "minimum": 1 },
            "max_tokens": { "type": "integer", "minimum": 1 },
            "max_wall_seconds": { "type": "integer", "minimum": 1 },
            "explicit_selection_required": { "type": "boolean" }
          }
        },
        "expensive": {
          "type": "object",
          "required": ["description", "providers", "max_outbound_attempts", "max_tokens", "max_wall_seconds"],
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string" },
            "providers": { "type": "array", "items": { "type": "string" } },
            "max_outbound_attempts": { "type": "integer", "minimum": 1 },
            "max_tokens": { "type": "integer", "minimum": 1 },
            "max_wall_seconds": { "type": "integer", "minimum": 1 },
            "explicit_selection_required": { "type": "boolean" }
          }
        }
      }
    }
  }
}
