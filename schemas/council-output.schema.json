{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gasyoun/RuWritingStyles/schemas/council-output.schema.json",
  "title": "RuWritingStyles council provider output",
  "type": "object",
  "required": ["run_id", "status", "replies", "decisions"],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["completed"]
    },
    "replies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
