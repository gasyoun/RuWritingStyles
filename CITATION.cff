    orcid: "https://orcid.org/0000-0003-4513-884X"
    alias: gasyoun
version: 2.15.1
date-released: '2026-07-19'
license: Apache-2.0
repository-code: "https://github.com/gasyoun/RuWritingStyles"
url: "https://github.com/gasyoun/RuWritingStyles"
keywords:
  - Sanskrit
  - linguistics
  - digital humanities
  - Russian
  - large language models
  - agentic review
  - scholarly writing
  - IAST transliteration
  - GOST R 7.0.100-2018
  - Indology
