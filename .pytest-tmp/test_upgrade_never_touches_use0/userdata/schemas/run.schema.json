{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gasyoun/RuWritingStyles/schemas/run.schema.json",
  "title": "RuWritingStyles run metadata",
  "type": "object",
  "required": ["run_id", "status", "text_domain"],
  "properties": {
    "run_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["prepared", "executing", "completed", "failed"]
    },
    "text_domain": {
      "type": "string",
      "enum": [
        "dialectology",
        "discourse_analysis",
        "etymology",
        "functional_grammar",
        "grammar",
        "historical_linguistics",
        "history",
        "indology",
        "lexicography",
        "linguistics",
        "literary_bakhtin",
        "literary_poststructural",
        "literary_textology",
        "literature",
        "normative",
        "oriental_studies",
        "philology",
        "sanskrit",
        "semantics",
        "semiotics",
        "typology",
        "unknown"
      ],
      "default": "unknown"
    },
    "input_path": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": ["string", "null"] },
    "archetype": { "type": ["string", "null"] },
    "profile": { "type": ["string", "null"] },
    "started_at": { "type": ["string", "null"] },
    "finished_at": { "type": ["string", "null"] },
    "duration_seconds": { "type": ["number", "null"] },
    "summary": { "type": ["string", "null"] },
    "config": { "type": ["object", "null"] },
    "pipeline_options": { "type": ["object", "null"] },
    "step_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "provider_backed"],
        "properties": {
          "step_id": { "type": "string" },
          "provider_backed": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "budget": {
      "type": ["object", "null"],
      "properties": {
        "mode": { "type": "string" },
        "provider": { "type": "string" },
        "limits": { "type": "object" },
        "consumption": { "type": "object" },
        "exhaustion_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "metrics": { "type": "object" },
    "steps": { "type": "array", "items": { "type": "object" } },
    "styles": {
      "type": "object",
      "properties": {
        "selected": { "type": "array", "items": { "type": "object" } },
        "council_decisions": { "type": "object" },
        "overruled": { "type": "array", "items": { "type": "object" } },
        "stylistic_commitments": { "type": "array", "items": { "type": "object" } }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
