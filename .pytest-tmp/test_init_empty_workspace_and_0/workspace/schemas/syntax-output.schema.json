{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Syntax Shift Output",
  "type": "object",
  "properties": {
    "run_id": { "type": "string" },
    "shifts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["passive_to_active", "active_to_passive", "inversion", "segmentation", "merging", "role_change", "other"]
          },
          "original_span": { "type": "string" },
          "revised_span": { "type": "string" },
          "comment": { "type": "string" }
        },
        "required": ["type", "original_span", "revised_span", "comment"]
      }
    }
  },
  "required": ["run_id", "shifts"]
}
