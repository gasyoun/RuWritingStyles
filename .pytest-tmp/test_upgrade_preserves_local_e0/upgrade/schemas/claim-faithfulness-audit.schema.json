{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gasyoun/RuWritingStyles/schemas/claim-faithfulness-audit.schema.json",
  "title": "Claim-faithfulness audit packet",
  "type": "object",
  "required": ["run_id", "status", "source_protocol", "claims"],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in_review", "calibrated", "needs_human_review"]
    },
    "source_protocol": {
      "type": "string",
      "minLength": 1
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "span_id",
          "claim_text",
          "citation_ids",
          "locator",
          "support_status",
          "severity",
          "rationale",
          "reviewer_action"
        ],
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^claim-[0-9]{3,}$"
          },
          "span_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_text": {
            "type": "string",
            "minLength": 1
          },
          "citation_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "locator": {
            "type": "object",
            "required": ["kind", "target"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["page", "section", "sutra", "verse", "url", "local_note", "unknown"]
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "support_status": {
            "type": "string",
            "enum": [
              "supported",
              "partly_supported",
              "unsupported",
              "wrong_source",
              "anchor_missing",
              "needs_human_review"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warn", "high_warn"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "reviewer_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "precision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "false_positive_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "false_negative_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "agreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
