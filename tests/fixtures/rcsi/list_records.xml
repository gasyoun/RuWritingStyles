	<dc:title xml:lang="en-US">Biodiversity of Ethiopian aquatic ecosystems</dc:title>
	<dc:title xml:lang="ru-RU">Биоразнообразие водных экосистем Эфиопии</dc:title>
	<dc:creator>Golubtsov A.S.</dc:creator>
	<dc:creator>Levin B.A.</dc:creator>
	<dc:creator>Neretina A.N.</dc:creator>
	<dc:creator>Kotov A.A.</dc:creator>
