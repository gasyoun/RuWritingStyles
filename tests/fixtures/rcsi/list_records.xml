	<dc:title xml:lang="ru-RU">Корпусная лингвистика на современном этапе</dc:title>
	<dc:creator>Plungian V.A.</dc:creator>
	<dc:subject xml:lang="en-US">corpus linguistics; linguistic theory; linguistic methodology; functional linguistics</dc:subject>
