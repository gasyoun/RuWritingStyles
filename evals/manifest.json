{
  "version": "0.1",
  "description": "Minimal RuWritingStyles evaluation set for comparing providers and model routes.",
  "cases": [
    {
      "id": "pseudo-etymology",
      "input": "examples/input/pseudo-etymology.md",
      "purpose": "Check whether style reviewers flag an unsupported etymological hypothesis and preserve cautious wording.",
      "default_styles": [
        "zalizniak-ocherk",
        "zalizniak-zametki",
        "tronsky-readings"
      ],
      "expected_risks": [
        "unsupported_etymology",
        "external_similarity_as_evidence",
        "missing_historical_forms"
      ],
      "scoring": {
        "required_finding_types": [
          "unsupported_etymology",
          "external_similarity_as_evidence",
          "missing_historical_forms"
        ],
        "min_required_matches": 1,
        "allowed_verification_statuses": [
          "passed",
          "needs_human_review"
        ],
        "max_changed_line_ratio": 0.75,
        "max_char_delta_ratio": 0.5,
        "strict_fidelity": true
      }
    },
    {
      "id": "source-claim",
      "input": "examples/input/source-claim.md",
      "purpose": "Check whether style reviewers separate a late source note from a strong claim about an early stable tradition.",
      "default_styles": [
        "zalizniak-ocherk",
        "tronsky-readings",
        "albedil-sbornik"
      ],
      "expected_risks": [
        "missing_source_reference",
        "overgeneralized_tradition_claim",
        "weak_evidence_for_dating"
      ],
      "scoring": {
        "required_finding_types": [
          "missing_source_reference",
          "overgeneralized_tradition_claim",
          "weak_evidence_for_dating"
        ],
        "min_required_matches": 1,
        "allowed_verification_statuses": [
          "passed",
