{
  "name": "ruwritingstyles-obsidian",
  "version": "0.1.0",
  "description": "Obsidian plugin for RuWritingStyles deterministic philological checks (IAST transliteration + journal compliance).",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test test/parity.test.ts"
  },
  "keywords": [
    "obsidian",
    "sanskrit",
    "iast",
    "transliteration",
    "philology"
  ],
  "author": "M. Yu. Gasuns",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.1",
    "obsidian": "1.5.7",
    "typescript": "5.4.5"
  }
}
