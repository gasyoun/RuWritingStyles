{
  "name": "ruwritingstyles-obsidian",
  "version": "0.1.0",
  "description": "Obsidian plugin for RuWritingStyles deterministic philological checks (IAST transliteration + journal compliance).",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "keywords": [
    "obsidian",
    "sanskrit",
    "iast",
    "transliteration",
    "philology"
  ],
  "author": "M. Yu. Gasuns",
  "license": "Apache-2.0",
  "devDependencies": {
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@types/node": "^25.9.3",
    "builtin-modules": "^5.2.0",
    "esbuild": "^0.28.1",
    "obsidian": "1.5.7",
    "typescript": "6.0.3"
  }
}
