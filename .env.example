# RuWritingStyles Environment Variables
# Copy this file to .env and fill in your keys

# Google Gemini (Direct API)
GOOGLE_API_KEY=your_key_here

# OpenRouter / Nous Portal (Access to 29+ free models)
OPENROUTER_API_KEY=your_key_here
# Alternative: NOUS_PORTAL_API_KEY=your_key_here

# Optional: Specific Model Selections
# RWS_OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Optional: Other providers
# ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here

# Optional: local/private providers
# RWS_OLLAMA_URL=http://localhost:11434/api/chat
# RWS_OLLAMA_MODEL=llama3.1
# RWS_LOCAL_LLM_URL=http://localhost:8000/v1/chat/completions
# RWS_LOCAL_LLM_MODEL=local-model

# Optional: path to the private research corpus (default: ../RuWritingStyles-corpus/PDFtoTXT)
# RWS_CORPUS_DIR=C:/Users/user/Documents/GitHub/RuWritingStyles-corpus/PDFtoTXT
