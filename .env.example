# RuWritingStyles Environment Variables
# Copy this file to .env and fill in your keys

# Google Gemini (Direct API)
GOOGLE_API_KEY=your_key_here

# OpenRouter / Nous Portal (Access to 29+ free models)
OPENROUTER_API_KEY=your_key_here
# Alternative: NOUS_PORTAL_API_KEY=your_key_here

# Optional: Specific Model Selections
# RWS_OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Optional: Other providers
# ANTHROPIC_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here

# Optional: local/private providers
# RWS_OLLAMA_URL=http://localhost:11434/api/chat
# RWS_OLLAMA_MODEL=llama3.1
# RWS_LOCAL_LLM_URL=http://localhost:8000/v1/chat/completions
# RWS_LOCAL_LLM_MODEL=local-model

# Optional: path to the private research corpus (default: ../RuWritingStyles-corpus/PDFtoTXT)
# RWS_CORPUS_DIR=C:/Users/user/Documents/GitHub/RuWritingStyles-corpus/PDFtoTXT

# Optional: offline mode — disables outbound scholarly API calls (OpenAlex).
# Set automatically by the test suite and by `--provider mock` eval runs.
# RWS_OFFLINE=1

# --- Web API hardening (see docs/security-review-2026-06.md) ---
# The API is a loopback single-user dev tool by default. To expose it on a
# routable interface you MUST set both of:
#   RWS_BIND_HOST   — bind address; default 127.0.0.1. Set 0.0.0.0 to go public.
#   RWS_API_TOKEN   — when set, ALL routes except the static frontend require
#                     `Authorization: Bearer <token>` (default-deny; WS also
#                     accepts ?token=).
# RWS_BIND_HOST=0.0.0.0
# RWS_API_TOKEN=change-me-to-a-long-random-secret
# Optional: widen the directory /runs/execute may read input files from
# (default: the repo root). Set to a documents folder for out-of-repo inputs.
# RWS_INPUT_ROOT=C:/Users/user/Documents
