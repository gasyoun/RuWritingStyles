# Copy to .env for local real-provider runs. Never commit real API keys.

# OpenAI
OPENAI_API_KEY=
RWS_OPENAI_MODEL=gpt-5.5
RWS_OPENAI_REASONING=medium

# Google Gemini
GEMINI_API_KEY=
# GOOGLE_API_KEY=
RWS_GOOGLE_MODEL=gemini-3.1-pro-preview

# Anthropic Claude
ANTHROPIC_API_KEY=
RWS_ANTHROPIC_MODEL=claude-sonnet-4-6
RWS_ANTHROPIC_MAX_TOKENS=4096

# Shared retry behavior for transient provider failures.
RWS_PROVIDER_MAX_ATTEMPTS=3
RWS_PROVIDER_RETRY_SECONDS=1
